# Orbit Personal Access — Environment Variables
#
# Copy this file to `.env.local` and fill in your values.
# `.env*` is gitignored — never commit real secrets.
#
# Generate both values with:
#   node scripts/generate-auth-secrets.mjs
#
# ─────────────────────────────────────────────────────────────────────────────
# ORBIT_PASSWORD_HASH
#
# Two accepted forms:
#
#   1. base64-encoded bcrypt hash   (REQUIRED inside .env files)
#      Next.js expands `$`-prefixed values in .env files, which silently turns
#      a raw bcrypt hash into an empty string. Base64 has no `$`, so it is safe.
#      Example: ORBIT_PASSWORD_HASH="JDJiJDEyJGxvdy4uLi4="
#
#   2. raw bcrypt hash               (use this in your host's secret manager)
#      Example: ORBIT_PASSWORD_HASH="$2b$12$..."
#
# The server auto-detects which form is in use.
# ─────────────────────────────────────────────────────────────────────────────
ORBIT_PASSWORD_HASH=

# ORBIT_SESSION_SECRET
# 32 random bytes, base64 encoded. Signs the session cookie.
# Generate with: openssl rand -base64 32
ORBIT_SESSION_SECRET=
